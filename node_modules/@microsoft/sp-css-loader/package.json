{
  "name": "@microsoft/sp-css-loader",
  "version": "1.22.2",
  "description": "A simplified css-loader for Webpack",
  "license": "https://aka.ms/spfx/license",
  "homepage": "http://aka.ms/spfx",
  "main": "lib-commonjs/index.js",
  "module": "lib-esm/index.js",
  "typings": "lib-dts/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js",
      "types": "./lib-dts/index.d.ts"
    },
    "./lib/*": {
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js",
      "types": "./lib-dts/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib-dts/*"
      ]
    }
  },
  "peerDependencies": {
    "webpack": "^5.88.1"
  },
  "devDependencies": {
    "@rushstack/heft": "1.1.2",
    "@types/loader-utils": "2.0.6",
    "@types/postcss-modules-extract-imports": "3.0.5",
    "@types/postcss-modules-local-by-default": "4.0.2",
    "@types/postcss-modules-scope": "3.0.4",
    "@types/postcss-modules-values": "4.0.2",
    "eslint": "8.57.1",
    "webpack": "~5.95.0",
    "@msinternal/internal-node-rig": "0.1.0"
  },
  "dependencies": {
    "@microsoft/load-themed-styles": "1.10.292",
    "@rushstack/node-core-library": "5.17.1",
    "autoprefixer": "^10.4.21",
    "css-loader": "~7.1.2",
    "cssnano": "~5.1.14",
    "loader-utils": "~3.2.1",
    "postcss": "^8.4.33",
    "postcss-modules-extract-imports": "^3.1.0",
    "postcss-modules-local-by-default": "^4.2.0",
    "postcss-modules-scope": "^3.2.1",
    "postcss-modules-values": "^4.0.0"
  },
  "scripts": {
    "build": "heft test --clean",
    "clean": "heft clean",
    "start": "heft build-watch",
    "test-watch": "heft test-watch",
    "_phase:depscan": "heft depscan",
    "_phase:tool-build": "heft run --only build -- --clean",
    "_phase:tool-build:incremental": "heft run --only build --"
  }
}